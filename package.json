{
  "name": "toolkit-x",
  "version": "0.69.0",
  "description": "Toolkit X, a Web UI toolkit",
  "private": true,
  "main": "src/index.js",
  "scripts": {
    "typecheck": "node node_modules/typescript-7/lib/tsc.js -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "node build.js",
    "demo": "vite demo",
    "demo:release": "npm run build && vite demo --mode release",
    "update-opera": "npm run build && cp dist/toolkit-0.69.0.js $WORK_DIR",
    "watch": "npm-watch update-opera",
    "prepare": "simple-git-hooks"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aswitalski/toolkit-x.git"
  },
  "keywords": [
    "web ui",
    "toolkit",
    "native",
    "javascript",
    "framework",
    "virtual dom"
  ],
  "author": "Aleksander Świtalski",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/aswitalski/toolkit-x/issues"
  },
  "homepage": "https://github.com/aswitalski/toolkit-x#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/browser-playwright": "^5.0.2",
    "@vitest/coverage-v8": "^5.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "lazy-module-loader": "^1.0.2",
    "lint-staged": "^17.6.0",
    "npm-watch": "^0.13.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "watch": {
    "update-opera": {
      "patterns": [
        "src",
        "test"
      ],
      "extensions": "js",
      "quiet": true
    }
  },
  "type": "module",
  "exports": "./src/index.js",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "simple-git-hooks@2.14.0": true,
    "fsevents": false
  },
  "engines": {
    "node": ">=24"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "pre-push": "npm run lint && npm run typecheck && npm test"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,html,css,yml,md}": "prettier --write"
  }
}
